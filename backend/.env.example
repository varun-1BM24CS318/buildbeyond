# CrisisGrid - Backend Environment Configuration Template
# Copy this file to backend/.env for local FastAPI development

# Host and port for production process managers
HOST=0.0.0.0
PORT=8000

# Secret API key required for mutating REST endpoints (POST /api/simulation/*)
X_API_KEY=crisis-allocation-demo-secret-key-2026

# CORS allowed frontend origins (comma-separated list for multi-environment/preview support)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Regex for dynamic preview deployments (e.g. Vercel deployment URLs)
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Google Gemini API key for Natural Language Disaster Director parsing
# Optional: System defaults to regex/rule-based parser when omitted
GEMINI_API_KEY=your_gemini_api_key_here
DIRECTOR_LLM_API_KEY=your_gemini_api_key_here

# SQLite Ledger database path (persistent storage)
LEDGER_DB_PATH=backend/data/crisis_ledger.db

# Feature flags (default: true)
VERIFICATION_ENABLED=true
NETWORK_MODEL_ENABLED=true
ADVANCED_VCG_ENABLED=true

# Supabase Cloud Database (optional live ledger mirroring)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here
