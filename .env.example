# CrisisGrid - Frontend Environment Configuration Template
# Copy this file to .env.local for local Next.js development

# Backend API endpoint (FastAPI gateway)
# Optional in local development (defaults to http://127.0.0.1:8000)
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# WebSocket connection URL for live event streaming
# Optional (automatically derived from NEXT_PUBLIC_BACKEND_URL; auto-upgraded to wss:// on HTTPS)
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws

# Google Gemini API key (server-side only for Next.js route handler /api/ai)
# Optional: The application operates 100% deterministically using SciPy HiGHS LP shadow prices if omitted
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (optional, default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Supabase Cloud Database (optional live multi-agent ledger mirroring)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
